---
interface Props {
  title: string;
}

const { title } = Astro.props;
// Codifichiamo il titolo per evitare problemi con spazi o caratteri speciali negli URL
const encodedTitle = encodeURIComponent(title);
---

<div class="share-container">
  <span class="share-title">Condividi questo articolo:</span>
  <div class="share-buttons">
    <!-- WhatsApp -->
    <a 
      href="#" 
      data-share-url="https://api.whatsapp.com/send?text=" 
      data-title={encodedTitle}
      class="share-btn whatsapp" 
      target="_blank" 
      rel="noopener noreferrer"
      aria-label="Condividi su WhatsApp"
    >
      📱 WhatsApp
    </a>

    <!-- Facebook -->
    <a 
      href="#" 
      data-share-url="https://www.facebook.com/sharer/sharer.php?u=" 
      class="share-btn facebook" 
      target="_blank" 
      rel="noopener noreferrer"
      aria-label="Condividi su Facebook"
    >
      👥 Facebook
    </a>

    <!-- LinkedIn -->
    <a 
      href="#" 
      data-share-url="https://www.linkedin.com/sharing/share-offsite/?url=" 
      class="share-btn linkedin" 
      target="_blank" 
      rel="noopener noreferrer"
      aria-label="Condividi su LinkedIn"
    >
      💼 LinkedIn
    </a>
  </div>
</div>

<script>
  // Script che gira nel browser per iniettare l'URL corrente esatto della pagina online
  const currentUrl = encodeURIComponent(window.location.href);
  const shareButtons = document.querySelectorAll('.share-btn');

  shareButtons.forEach(btn => {
    const baseUrl = btn.getAttribute('data-share-url');
    const title = btn.getAttribute('data-title') || '';
    
    if (btn.classList.contains('whatsapp')) {
      btn.setAttribute('href', `${baseUrl}${title}%20${currentUrl}`);
    } else {
      btn.setAttribute('href', `${baseUrl}${currentUrl}`);
    }
  });
</script>

<style>
  .share-container {
    margin: 3rem 0;
    padding: 1.5rem 0;
  }
  
  .share-title {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--brand-gold);
    font-weight: bold;
    display: block;
    margin-bottom: 1rem;
  }

  .share-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.2rem;
    border-radius: 30px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    color: #333;
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.1);
    transition: all 0.2s ease;
  }

  .share-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
  }

  /* Opzionale: Personalizzazione colori al passaggio del mouse */
  .share-btn.whatsapp:hover { border-color: #25D366; color: #25D366; }
  .share-btn.facebook:hover { border-color: #1877F2; color: #1877F2; }
  .share-btn.linkedin:hover { border-color: #0A66C2; color: #0A66C2; }
</style>